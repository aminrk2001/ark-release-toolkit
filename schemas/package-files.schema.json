{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aminrk2001/ark-release-toolkit/blob/main/schemas/package-files.schema.json",
  "title": "ARK Release Toolkit WordPress package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "products"],
  "properties": {
    "schema_version": {"const": 1},
    "products": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "files"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
